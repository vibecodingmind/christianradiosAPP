<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Many RadioBrowser / Icecast streams still use plain HTTP. -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
